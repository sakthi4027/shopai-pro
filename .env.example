# Application
PROJECT_NAME="E-Commerce AI Multi-Agent Shopping Assistant"
API_V1_PREFIX="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL in production, SQLite out-of-the-box fallback)
# For local SQLite:
DATABASE_URL="sqlite+aiosqlite:///./ecommerce_agent.db"
DATABASE_URL_SYNC="sqlite:///./ecommerce_agent.db"
# For PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce_ai"
# DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/ecommerce_ai"

# Redis (Optional caching & pub-sub)
REDIS_URL="redis://localhost:6379/0"

# LLM Providers (Optional - built-in deterministic NLP engine works out of the box)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Playwright & Scraping Settings
PLAYWRIGHT_HEADLESS=true
BROWSER_TIMEOUT_MS=15000
SAFE_MODE=true

# Regional Defaults
DEFAULT_CURRENCY="INR"
CURRENCY_SYMBOL="₹"
