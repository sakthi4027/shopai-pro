# ==============================================================================
# E-Commerce AI Multi-Agent Shopping Assistant - Environment Configuration
# ==============================================================================

# LLM Providers (Enter your API keys below)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Live Search Engine APIs (Optional: SerpApi, Google Custom Search, Bing Search)
# The system automatically executes live web scraping even without these keys!
SERPAPI_API_KEY=""
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""
BING_SEARCH_API_KEY=""

# Application Security & JWT
SECRET_KEY="prod-super-secret-key-change-in-production-ecommerce-multi-agent-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL="sqlite+aiosqlite:///./ecommerce_agent.db"
DATABASE_URL_SYNC="sqlite:///./ecommerce_agent.db"
# PostgreSQL Configuration (uncomment to connect to PostgreSQL):
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce_ai"
# DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/ecommerce_ai"

# Redis Cache (Optional)
REDIS_URL="redis://localhost:6379/0"

# Playwright Browser Automation
PLAYWRIGHT_HEADLESS=true
BROWSER_TIMEOUT_MS=15000
SAFE_MODE=true

# Regional Settings
DEFAULT_CURRENCY="INR"
CURRENCY_SYMBOL="₹"
